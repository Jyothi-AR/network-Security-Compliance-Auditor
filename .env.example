# PostgreSQL connection URL (production)
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://compliance:compliance123@localhost:5432/compliance_db

# SQLite fallback for local dev (used when DATABASE_URL is not set)
# DATABASE_URL=sqlite:///./data/compliance.db

# API settings
API_HOST=0.0.0.0
API_PORT=8000
